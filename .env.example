# MARScope settings. Copy to .env (never commit .env) and fill in what you need: cp .env.example .env
# Everything is optional: without a language model the report summary comes from a template.

# --- Language model for the report summary and Ask (any OpenAI-compatible endpoint) ---
# Only the structured result, the notes and your tests in words are sent; never the video or frames.
# Left empty, the language model is off. Example: https://your-endpoint/v1
MARSCOPE_LLM_BASE_URL=
MARSCOPE_LLM_API_KEY=
# Exactly as the endpoint lists it (names are case-sensitive), e.g. Qwen3_6-35B-A3B.
MARSCOPE_LLM_MODEL=

# Cache folders are set in the shell, not here (they are read before this file):
#   export HF_HOME=/path/to/hf-cache            models (default ~/.cache/huggingface)
#   export MARSCOPE_CACHE=/path/to/cache        face detector and small files (default ~/.cache/marscope)

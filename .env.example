# Copy to .env and edit for your machine / cluster:
#   cp .env.example .env
#
# Loaded by the config loaders (expands ${VAR} in configs/eval.yaml) and by the
# launchers scripts/eval.sh / scripts/forward.sh. Real environment variables
# always take precedence over values set here.

# Shared FFmpeg 7.x prefix (contains bin/ and lib/, e.g. libavutil.so.59).
# Required by TorchCodec / vLLM video decode.
FFMPEG_SHARED=/path/to/ffmpeg-shared-7

# Eval data. MANIFEST_DIR/RAW_DATA_DIR are read by configs/eval.yaml (${VAR}).
MANIFEST_DIR=/path/to/deepfake-detection/data/processed/_manifests
RAW_DATA_DIR=/path/to/deepfake-detection/data/raw

# Optional: scripts/eval.sh symlinks these dataset dirs from RAW_DATA_DIR into
# MANIFEST_DATA_ROOT so the manifest src_path prefix resolves to on-disk data.
MANIFEST_DATA_ROOT=/path/to/deepfake_data
DATASET_SYMLINKS="LAV-DF ArEnAV_subset"
